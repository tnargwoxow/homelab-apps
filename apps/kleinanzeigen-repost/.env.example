# Your own Kleinanzeigen account login.
KA_EMAIL=you@example.com
KA_PASSWORD=your-account-password

# Optional: a session token captured from the logged-in app. If set, the tool
# skips the /users/login call, which Kleinanzeigen anti-fraud-gates heavily on
# shared mobile/CGNAT and VPN/datacenter IPs. With KA_TOKEN you can omit
# KA_PASSWORD. See README "Getting a token from your phone".
#KA_TOKEN=

# Partner-app credentials are baked into the code as defaults. Only set these
# if Kleinanzeigen rotates them. NOTE: KA_APP_TYPE must be a *current* app
# version — the old "ebayk-android-app-13.4.2" is blocked as outdated.
#KA_APP_ID=13a6dde3-935d-4cd8-9992-db8a8c4b6c0f1456515662229
#KA_APP_VERSION=100.9.0
#KA_APP_TYPE=ebayk-android-app-100.9.0
#KA_APP_UA=Dalvik/2.2.0
#KA_APP_USERNAME=android
#KA_APP_PASSWORD=TaR60pEttY
